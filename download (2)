// Mantém os trechos mostrados na página idênticos ao Pascal fornecido.
const fs = require('node:fs');
const path = require('node:path');
const sourcePath = process.argv[2] || path.join(__dirname, '..', 'N08EVANDRO.pas');
if (!sourcePath) throw new Error('Informe o arquivo Pascal original.');
const text = fs.readFileSync(sourcePath, 'utf8').replace(/\r\n?/g, '\n');
const blocks = [
  {id:'intro',start:1,end:4,title:'O nome do programa e a biblioteca',explain:'PROGRAM N08EVANDRO dá nome ao programa. O comentário identifica o autor. USES TARDENOITE importa os tipos regis e vetor e os procedimentos ordem e pebin1; as implementações deles ficam na unit, fora deste arquivo.',example:'Pense em TARDENOITE como uma caixa de ferramentas que seu programa reutiliza.'},
  {id:'constants',start:6,end:10,title:'Os nomes e os pesos das seis disciplinas',explain:'CONST define os dois vetores fixos. O índice liga o nome ao peso da mesma disciplina. Em Pascal, os índices vão de 1 a 6. Conhecimento específico, índice 4, recebe peso 3; Informática, índice 5, peso 2.',example:'pesosDisciplinas[4] vale 3. A nota 90 dessa disciplina será gravada como 270.'},
  {id:'variables',start:12,end:31,title:'As variáveis que guardam o trabalho',explain:'arquivoCandidatos representa o arquivo de registros; arquivoNotas é texto. candidato guarda uma ficha por vez. vetorCandidatos liga inscrição e posição física. notasDaLinha guarda seis números temporários; notasSemPeso guarda as notas originais dos presentes. possuiNotas marca quem já recebeu notas. somasSemPeso acumula os totais de cada disciplina. Os contadores e booleanos controlam a execução.',example:'notasSemPeso[2,4] é a quarta nota da pessoa no índice 2 do vetor ordenado; não é a inscrição 2.'},
  {id:'format',start:33,end:40,title:'Sua função formatarInscricao',explain:'A função recebe um INTEGER e devolve STRING. STR converte o número para texto com largura de quatro posições. POS localiza espaços; WHILE troca cada espaço por zero. A atribuição ao nome da função devolve o resultado.',example:'12 → STR produz "  12" → o WHILE transforma em "0012". Assim, comparar inscrições como texto mantém a ordem numérica.'},
  {id:'open',start:42,end:50,title:'Abrir CAND.IND e respeitar o limite',explain:'O BEGIN da linha 42 inicia o programa principal. ASSIGN associa a variável ao arquivo; RESET abre o arquivo existente. FILESIZE informa a quantidade de registros. Acima de 3.000, o programa fecha o arquivo e termina com HALT para não ultrapassar os vetores.',example:'O Pascal depende do arquivo existente e do modo de abertura do ambiente. Neste laboratório, uma lista em memória representa o cadastro.'},
  {id:'filter',start:52,end:66,title:'Ler o cadastro e separar os presentes',explain:'totalPresentes e posicaoFisica começam em zero. WHILE NOT EOF lê até o fim. READ carrega uma ficha em candidato. Só FALTA = 0 entra no vetor: CC recebe a inscrição e PF recebe sua posição original. posicaoFisica aumenta também para os ausentes.',example:'O candidato de inscrição 0012 pode estar na PF 2, mesmo que, depois de ordenar, esteja no índice 2 do vetor Pascal. São informações diferentes.'},
  {id:'sort',start:68,end:69,title:'Ordenar para usar pesquisa binária',explain:'ordem recebe o vetor e o total de presentes. Só é chamada quando há mais de um elemento. Ordena pela inscrição em CC; PF acompanha a chave em cada troca. A ordem do arquivo CAND.IND permanece igual.',example:'0030/PF0, 0012/PF2 → 0012/PF2, 0030/PF0. A PF continua apontando ao registro correto.'},
  {id:'initialize',start:70,end:74,title:'Preparar as marcas e os acumuladores',explain:'O primeiro FOR coloca FALSE em possuiNotas para cada presente. O segundo zera as seis somas. totalNotasIgnoradas e totalNotasDuplicadas começam em zero. encontrouErro começa em FALSE.',example:'FALSE significa “ainda não recebeu notas”. Um erro encontrado depois muda encontrouErro para TRUE e bloqueia a atualização.'},
  {id:'line',start:76,end:88,title:'Ler uma linha e validar a inscrição',explain:'O programa abre NOTAS.TXT e lê com READLN. LENGTH exige exatamente 28 caracteres. COPY extrai os quatro primeiros; VAL tenta convertê-los em numeroInscricao. codigoConversao = 0 indica sucesso. A inscrição aceita vai de 1 a 9999.',example:'0012 + seis campos de quatro caracteres = 4 + 6 × 4 = 28. Espaços dentro dos campos contam.'},
  {id:'search',start:89,end:94,title:'Encontrar a inscrição com pebin1',explain:'A inscrição numérica é formatada novamente com quatro dígitos. posicaoEncontrada começa em zero. Se existem presentes, pebin1 pesquisa a inscrição no vetor ordenado e devolve seu índice por referência. Zero significa não encontrada.',example:'No Pascal, índice 2 significa vetorCandidatos[2]. A posição do registro no arquivo está em vetorCandidatos[2].pf. A animação do meio da busca representa o trabalho interno de pebin1 na unit.'},
  {id:'ignore',start:95,end:98,title:'Ignorar quem não está entre os presentes',explain:'Se posicaoEncontrada é zero, totalNotasIgnoradas aumenta. A inscrição pode ser de um ausente ou inexistente. O ELSE só é executado quando o candidato foi encontrado entre os presentes.',example:'Uma inscrição ignorada não bloqueia a execução. Nesse ramo, os seis campos de notas não chegam a ser convertidos e validados.'},
  {id:'parse',start:99,end:107,title:'Extrair e validar as seis notas',explain:'O FOR repete de 1 a 6. A expressão 5 + (indiceDisciplina - 1) × 4 calcula os inícios 5, 9, 13, 17, 21 e 25. COPY extrai quatro caracteres e VAL converte. Erro na conversão ou nota fora de 0 a 100 deixa linhaValida em FALSE.',example:'Para a disciplina 4: 5 + (4 - 1) × 4 = 17. Seu campo ocupa as colunas 17 a 20.'},
  {id:'duplicate',start:108,end:115,title:'Impedir notas duplicadas',explain:'A duplicidade é conferida apenas depois de validar as seis notas. Se possuiNotas já é TRUE para o índice encontrado, a inscrição tem outro conjunto válido de notas. O contador aumenta e encontrouErro recebe TRUE.',example:'Duas linhas válidas para 0012 bloqueiam a gravação. totalNotasDuplicadas é contado no código, embora não apareça no relatório final do Pascal.'},
  {id:'store',start:116,end:121,title:'Guardar as notas originais na memória',explain:'Quando não há duplicidade, possuiNotas fica TRUE. O FOR copia notasDaLinha para a linha correspondente de notasSemPeso. A chave dessa matriz é o índice do vetor ordenado, não a inscrição e não a PF.',example:'Neste ponto nenhuma nota foi escrita em CAND.IND. As notas originais ficam guardadas para conferir tudo antes de atualizar.'},
  {id:'error',start:125,end:131,title:'Registrar uma linha inválida',explain:'Se linhaValida ficou FALSE, o programa marca encontrouErro e mostra a linha problemática. O laço continua para conferir as outras linhas. CLOSE fecha NOTAS.TXT quando a leitura acaba.',example:'Uma nota 140 torna a linha inválida. Se era a única linha daquele presente, a checagem seguinte também indicará presente sem notas.'},
  {id:'missing',start:133,end:138,title:'Verificar se algum presente ficou sem notas',explain:'O programa percorre todos os índices dos presentes. Se possuiNotas continua FALSE, não houve um conjunto válido para aquela pessoa. Mostra a inscrição guardada em CC e marca erro.',example:'Um presente que não aparece em NOTAS.TXT impede a atualização, mesmo que todas as outras linhas estejam corretas.'},
  {id:'halt',start:139,end:144,title:'Encerrar antes de gravar se houve erro',explain:'Se encontrouErro é TRUE, o programa avisa que nada foi alterado, fecha CAND.IND e termina com HALT. Só se a conferência inteira passar é que o programa chega ao laço de atualização.',example:'É uma conferência prévia. O código não implementa desfazimento caso uma falha aconteça durante as gravações posteriores.'},
  {id:'seek',start:146,end:149,title:'Começar a atualização pela posição física',explain:'totalAtualizados começa em zero. O FOR percorre os presentes na ordem do vetor. SEEK vai ao registro indicado por PF, que ainda é sua posição original em CAND.IND.',example:'SEEK recebe a posição física, não o número da inscrição e não o índice do vetor.'},
  {id:'read',start:150,end:151,title:'Ler a ficha e zerar a soma',explain:'READ carrega o registro em candidato e avança o cursor do arquivo. candidato.som recebe zero para acumular o novo total, sem somar ao resultado antigo.',example:'Se o registro está na PF 2, depois do READ o cursor está na PF 3. A ficha em memória continua sendo a da PF 2.'},
  {id:'weight',start:152,end:160,title:'Separar a média sem peso da soma com peso',explain:'Para cada disciplina, a nota original entra em somasSemPeso. Em candidato.notas, a mesma nota é multiplicada pelo peso. candidato.som acumula as seis notas já ponderadas.',example:'Uma nota 90 de N4 adiciona 90 à soma da disciplina e 270 ao total do candidato. São dois acumuladores com finalidades diferentes.'},
  {id:'classify',start:162,end:164,title:'Zerar as classificações anteriores',explain:'CLG é classificação geral; CLC, classificação no cargo; CCL, cargo de classificação. O N08 zera esses campos dos presentes atualizados. A classificação será refeita pelo trabalho 09.',example:'Zerar não é classificar. Este programa atualiza notas e prepara os campos para a próxima etapa.'},
  {id:'writeSeek',start:166,end:167,title:'Voltar à mesma PF antes de escrever',explain:'Como READ avançou o cursor, o programa chama SEEK novamente com a PF do vetor. Assim, WRITE atualizará a mesma ficha que foi lida.',example:'READ na PF 2 deixa o cursor na PF 3. O segundo SEEK volta à PF 2 antes da gravação.'},
  {id:'write',start:168,end:171,title:'Gravar e contar os atualizados',explain:'WRITE salva o registro candidato na posição selecionada. totalAtualizados aumenta em um. O END fecha o laço e CLOSE fecha CAND.IND depois de concluir as atualizações.',example:'Somente os presentes que entraram no vetor são gravados. Os registros dos ausentes ficam preservados.'},
  {id:'means',start:173,end:185,title:'Mostrar o relatório e as médias',explain:'WRITELN mostra os totais. Cada média é somasSemPeso da disciplina dividida por totalAtualizados. :25 reserva largura para o nome; :8:2 mostra o resultado com largura mínima de oito caracteres e duas casas decimais. Sem presentes, mostra SEM PRESENTES e não divide por zero.',example:'A última mensagem orienta executar o trabalho 09. WRITELN apenas mostra o texto; não chama esse outro programa.'},
];
const lines=text.split('\n');
for(const block of blocks) {
  if(!lines[block.start-1]||block.end>lines.length) throw new Error('Intervalo inválido: '+block.id);
  block.code=lines.slice(block.start-1,block.end).join('\n');
}
const payload={text,blocks,author:'EVANDRO LIMA BARBOSA',name:'N08EVANDRO.pas'};
fs.writeFileSync(path.join(__dirname,'..','original-source.js'),'window.N08Original = '+JSON.stringify(payload,null,2)+';\n');
